<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title: 'Operaciones', cssFile: 'operations.css', extraCss: ['/css/components/modals-base.css', '/css/components/operational-modal.css'] }) %>
<body>
    <div class="layout">
        <%- include('../partials/sidebar', { activePage: 'operations' }) %>
        <main class="layout__content">
            <%- include('../partials/navbar', { title: 'Operaciones' }) %>

            <script nonce="<%= cspNonce %>">
                window.USER_ROLE = '<%= user && (user.is_admin || user.app_role === "admin") ? "admin" : "employee" %>';
                window.USER_APP_ROLE = '<%= user ? user.app_role : "" %>';
                window.USER_BRANCH_ID = <%- user && user.branch_id ? Number(user.branch_id) : 'null' %>;
                window.CAN_MANAGE_ALL_SHIPMENTS = <%= Boolean(user && (user.is_admin || user.app_role === 'admin' || user.app_role === 'stock_manager')) %>;
            </script>
            <script src="/js/operations.js?v=2.6" defer></script>

            <div class="main-container">
                <section class="alerts-section" id="alerts-section">
                    <div class="section-header">
                        <span class="material-symbols-outlined icon-alert" id="alert-icon">notifications_active</span>
                        <div>
                            <h2 id="alert-title">Envíos pendientes</h2>
                            <p class="text-muted">Despachá los envíos de tu sucursal o confirmá los que llegaron a destino.</p>
                        </div>
                    </div>
                    <div class="alerts-grid" id="alerts-grid-container">
                        <div class="shipment-loading">Buscando envíos...</div>
                    </div>
                </section>

                <hr class="divider">

                <section class="actions-section">
                    <div class="section-header">
                        <div>
                            <h2>Envíos, devoluciones y cambios</h2>
                            <p class="text-muted">Registrá traslados de stock entre sucursales, devoluciones o cambios de productos.</p>
                        </div>
                    </div>
                    <div class="action-cards-grid">
                        <button class="action-card card-transfer" type="button" onclick="openOperationModal('transfer')">
                            <div class="card-icon"><span class="material-symbols-outlined">local_shipping</span></div>
                            <div class="card-text">
                                <h3>Registrar envío</h3>
                                <p>Trasladar productos desde una sucursal hacia otra.</p>
                            </div>
                        </button>
                        <button class="action-card card-out" type="button" onclick="openOperationModal('out', 'return')">
                            <div class="card-icon"><span class="material-symbols-outlined">assignment_return</span></div>
                            <div class="card-text">
                                <h3>Registrar devolución</h3>
                                <p>Registrar la salida de productos vinculada a una devolución.</p>
                            </div>
                        </button>
                        <button class="action-card card-transfer" type="button" onclick="openOperationModal('out', 'exchange')">
                            <div class="card-icon"><span class="material-symbols-outlined">swap_horiz</span></div>
                            <div class="card-text">
                                <h3>Registrar cambio</h3>
                                <p>Registrar los productos entregados como parte de un cambio.</p>
                            </div>
                        </button>
                    </div>
                </section>
            </div>

            <% if (user && (user.role === 'admin' || user.app_role === 'stock_manager')) { %>
                <%- include('../partials/modals/modal-op-admin') %>
                <script src="/js/components/op-admin.js" defer></script>
            <% } else { %>
                <%- include('../partials/modals/modal-op-employee') %>
                <script src="/js/components/op-employee.js" defer></script>
            <% } %>

            <div class="modal-overlay" id="modal-shipment">
                <div class="modal-card modal-large modal-shipment-card">
                    <header class="modal-header modal-shipment-header" id="modal-shipment-header">
                        <div id="modal-shipment-icon" class="material-symbols-outlined modal-shipment-icon">local_shipping</div>
                        <div class="modal-shipment-title-container">
                            <h3 id="modal-shipment-title">Detalle del envío</h3>
                            <p id="modal-shipment-subtitle">Verificá los productos antes de confirmar.</p>
                        </div>
                        <button class="btn-close-modal" type="button" data-close-shipment aria-label="Cerrar">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </header>
                    <div class="modal-body modal-shipment-body">
                        <h4>Productos del envío</h4>
                        <div class="detail-products-container">
                            <table class="detail-products-table">
                                <thead><tr><th>SKU</th><th>Producto</th><th class="text-center">Cantidad</th></tr></thead>
                                <tbody id="shipment-products-list"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-actions modal-shipment-actions">
                        <button class="btn-cancel" type="button" data-close-shipment>Volver</button>
                        <button class="btn-primary" id="btn-confirm-shipment" type="button">
                            <span class="material-symbols-outlined" id="btn-confirm-shipment-icon">check_circle</span>
                            <span id="btn-confirm-shipment-text">Confirmar</span>
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
