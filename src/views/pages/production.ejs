<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title: 'Producción y artesanos', cssFile: 'production.css' }) %>
<body>
    <div class="layout">
        <%- include('../partials/sidebar', { activePage: 'production' }) %>
        <main class="layout__content">
            <%- include('../partials/navbar', { title: 'Producción y artesanos' }) %>
            <div class="production-container">
                <div id="production-message" class="message hidden"></div>
                <section class="summary-grid" id="summary-grid"></section>

                <div class="tabs" role="tablist">
                    <button class="tab active" data-tab="work">Ordenes de trabajo</button>
                    <button class="tab" data-tab="artisans">Artesanos</button>
                    <button class="tab" data-tab="packages">Bultos</button>
                </div>

                <section class="panel active" data-panel="work">
                    <div class="split">
                        <form id="work-form" class="card form-card">
                            <h3>Nueva orden de trabajo</h3>
                            <label>Tipo<select id="work-type" required>
                                <option value="manufacturing">Fabricación</option>
                                <option value="customization">Trabajo con artesano: plata, alpaca o dijes</option>
                            </select></label>
                            <label>Centro de origen<select id="work-branch" required></select></label>
                            <label>Producto<select id="work-output" required></select></label>
                            <label>Cantidad<input id="work-output-qty" type="number" min="1" required value="1"></label>
                            <label id="work-artisan-group">Artesano<select id="work-artisan"><option value="">Seleccionar artesano</option></select></label>
                            <div class="recipe-preview" id="work-recipe-preview">
                                Seleccioná un producto para ver los materiales que se descontarán.
                            </div>
                            <label>Costo acordado del artesano (opcional)<input id="work-cost" type="number" min="0" step="0.01"></label>
                            <label>Notas<textarea id="work-notes" rows="2"></textarea></label>
                            <button class="primary" type="submit">Crear borrador</button>
                        </form>
                        <div class="card table-card"><h3>Seguimiento y stock en poder de artesanos</h3><div class="table-wrap"><table><thead><tr><th>Orden</th><th>Artesano</th><th>Origen</th><th>En custodia</th><th>Resultado</th><th>Estado</th><th></th></tr></thead><tbody id="work-list"></tbody></table></div></div>
                    </div>
                </section>

                <section class="panel" data-panel="artisans">
                    <div class="split">
                        <form id="artisan-form" class="card form-card"><h3>Nuevo artesano</h3>
                            <label>Nombre<input id="artisan-name" required></label>
                            <label>Centro asociado<select id="artisan-branch" required></select></label>
                            <label>Telefono<input id="artisan-phone"></label>
                            <label>Especialidad<input id="artisan-specialty" placeholder="Plateria, marroquineria..."></label>
                            <label>Notas<textarea id="artisan-notes" rows="3"></textarea></label>
                            <button class="primary" type="submit">Guardar artesano</button>
                        </form>
                        <div class="card table-card"><h3>Artesanos</h3><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Centro</th><th>Especialidad</th><th>Telefono</th></tr></thead><tbody id="artisan-list"></tbody></table></div></div>
                    </div>
                </section>

                <section class="panel" data-panel="packages">
                    <div class="split">
                        <form id="package-form" class="card form-card"><h3>Preparar bulto mayorista</h3>
                            <label>Cliente / destinatario<input id="package-customer" required placeholder="Nombre del cliente"></label>
                            <div class="line-title">Productos del bulto</div>
                            <div id="package-item-lines" class="package-item-lines"></div>
                            <button type="button" class="secondary" id="btn-add-package-item">Agregar producto</button>
                            <label>Notas<textarea id="package-notes" rows="2"></textarea></label>
                            <p class="hint">Por ahora los bultos representan exclusivamente pedidos mayoristas enviados en la camioneta.</p>
                            <button class="primary" type="submit">Crear bulto</button>
                        </form>
                        <div class="card table-card"><h3>Bultos preparados</h3><div class="table-wrap"><table><thead><tr><th>Código</th><th>Cliente</th><th>Contenido</th><th>Estado</th></tr></thead><tbody id="package-list"></tbody></table></div></div>
                    </div>
                </section>
            </div>
            <script src="/js/production.js"></script>
        </main>
    </div>
</body>
</html>
