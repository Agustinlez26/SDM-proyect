<div class="modal-overlay" id="modal-add-product">
    <div class="modal-card">
        <header class="modal-header">
            <h3 id="product-modal-title">Añade un producto</h3>
            <button class="btn-close-modal" data-target="modal-add-product">
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>

        <form class="modal-form" id="form-product">
            <input type="hidden" id="prod-id">
            <input type="hidden" id="prod-is-active" value="1">

            <div class="modal-form-grid">
                <div class="modal-text-col">
                    <div class="form-group">
                        <label>Nombre del Producto</label>
                        <input type="text" id="prod-name" placeholder="Ej: Coca Cola 2.25L" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group" id="prod-sku-group">
                            <label>SKU</label>
                            <input type="text" id="prod-code" placeholder="Ej: MAT-SP" maxlength="50">
                        </div>
                        <div class="form-group">
                            <label>Categoría</label>
                            <select id="prod-category" required>
                                <option value="" disabled selected>Seleccionar...</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Descripción</label>
                        <textarea id="prod-desc" rows="4" placeholder="Detalles del producto..." required></textarea>
                    </div>
                </div>

                <div class="modal-image-col">
                    <div class="product-image-field">
                        <label id="prod-img-label" for="prod-img">Imagen del producto</label>
                        <div class="product-image-drop-zone" id="product-image-drop-zone" role="button" tabindex="0"
                            aria-label="Arrastrar una imagen o abrir el selector de archivos"
                            aria-describedby="prod-img-help prod-img-filename">
                            <div class="preview-img-container" id="preview-img-container">
                                <div class="product-image-placeholder" id="prod-img-placeholder">
                                    <span class="material-symbols-outlined" aria-hidden="true">add_photo_alternate</span>
                                    <strong id="prod-img-text">Arrastrá y soltá la imagen acá</strong>
                                    <span>o hacé clic para buscarla</span>
                                </div>
                                <img id="prod-img-preview" src="" alt="Vista previa del producto" hidden>
                            </div>
                        </div>
                        <input class="product-image-input" type="file" id="prod-img" name="image" accept="image/*">
                        <div class="product-image-meta">
                            <button type="button" class="btn-select-image" id="btn-select-product-image">
                                Seleccionar imagen
                            </button>
                            <span id="prod-img-filename" aria-live="polite">Ningún archivo seleccionado</span>
                        </div>
                        <small id="prod-img-help">JPG, PNG, WEBP u otra imagen, hasta 20 MB.</small>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" data-target="modal-add-product">Cancelar</button>
                <button type="submit" class="btn-confirm" id="btn-save-product">Guardar Producto</button>
            </div>
        </form>
    </div>
</div>
