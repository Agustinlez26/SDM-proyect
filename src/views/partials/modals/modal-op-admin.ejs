<div class="modal-overlay" id="modal-operation" data-user-branch-id="<%= user ? user.branch_id : '' %>">
    <div class="modal-card modal-large">
        <header class="modal-header">
            <div>
                <h3 id="modal-op-title">Título Operación</h3>
                <p id="modal-op-subtitle" class="text-muted" style="margin-top: 4px; font-size: 0.85rem;">Subtítulo</p>
            </div>
            <button class="btn-close-modal" id="btn-close-operation">
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>

        <div class="modal-body">
            <div class="op-controls-grid" id="op-controls">
                <div class="form-group" id="group-origin" style="display: none;">
                    <label>Sucursal Origen</label>
                    <select id="op-origin"><option value="" disabled selected>Seleccionar sucursal...</option></select>
                </div>
                <div class="form-group" id="group-dest" style="display: none;">
                    <label>Sucursal Destino</label>
                    <select id="op-dest">
                        <option value="" disabled selected>Seleccionar sucursal...</option>
                    </select>
                </div>
                <div class="form-group" id="group-egress-reason" style="display: none;">
                    <label>Motivo del egreso</label>
                    <select id="op-egress-reason">
                        <option value="return">Devolución</option>
                        <option value="exchange">Cambio de producto</option>
                    </select>
                </div>
                <div class="form-group" id="group-sale-channel" style="display: none;">
                    <label for="op-sale-channel">Canal de venta</label>
                    <select id="op-sale-channel">
                        <option value="" disabled selected>Seleccionar canal...</option>
                        <option value="mercado_libre">Mercado Libre</option>
                        <option value="tienda_nube">Tienda Nube</option>
                        <option value="mayorista">Mayorista</option>
                        <option value="merchandising">Merchandising</option>
                        <option value="showroom">Showroom</option>
                    </select>
                </div>
                <div class="form-group" id="group-explanation" style="display: none; grid-column: 1 / -1;">
                    <label for="op-explanation" id="op-explanation-label">Explicación</label>
                    <textarea id="op-explanation" rows="3" maxlength="1000"
                        placeholder="Describí el motivo y cualquier dato necesario para identificar la operación."></textarea>
                    <small class="text-muted">Este detalle quedará asociado al movimiento y al usuario responsable.</small>
                </div>

                <div class="form-group" id="group-search" style="display: none; grid-column: span 2;">
                    <label>Buscar Producto a agregar</label>
                    <div class="search-bar" style="position: relative;">
                        <span class="material-symbols-outlined search-icon">search</span>
                        <input type="text" id="op-search-prod" placeholder="Escanear código o escribir nombre..."
                            onkeypress="if(event.key === 'Enter') searchProductsForOperation()">
                        <button class="btn-mini-add" type="button" id="btn-search-prod"
                            onclick="searchProductsForOperation()">
                            <span class="material-symbols-outlined">search</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="catalog-wrapper mt-2">
                <div id="catalog-grid" class="catalog-grid"></div>
            </div>

            <div class="detail-products-container mt-2">
                <table class="detail-products-table">
                    <thead>
                        <tr></tr>
                    </thead>
                    <tbody id="op-products-list"></tbody>
                </table>
            </div>
        </div>

        <div class="modal-actions">
            <button class="btn-cancel" id="btn-cancel-op">Cancelar</button>
            <button class="btn-primary" id="btn-confirm-op">
                <span class="material-symbols-outlined" id="btn-confirm-icon">check_circle</span>
                <span id="btn-confirm-text">Confirmar</span>
            </button>
        </div>
    </div>
</div>
